# PostgreSQL
PG_URL=YOUR DB_URL

# RAG Service
RAG_SERVICE_URL=http://localhost:8000
# Public URL of this server (used to build absolute image URLs for RAG OCR)
BASE_URL=http://localhost:8090


# Redis
REDIS_ADDR=
REDIS_PASSWORD=

# SMTP (ex: Mailtrap)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# HTTP Server
HTTP_PORT=:

# Приватные файлы (чеки об оплате) — не раздаются через /static
PRIVATE_ROOT=./storage

# Telegram-бот для проверки оплат (пустой токен — бот выключен, подтверждать можно из админки)
# Группа с темами: добавьте бота админом, напишите /ids в нужной теме — бот ответит chat_id и message_thread_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PAYMENTS_THREAD_ID=
TELEGRAM_HISTORY_THREAD_ID=
# Кто может нажимать «Подтвердить» (user id через запятую); пусто — любой участник группы
TELEGRAM_ADMIN_IDS=
